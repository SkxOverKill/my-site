{
  "name": "pulse_intelligence",
  "version": "0.1.0",
  "description": "Open-source, self-hosted threat intelligence platform for analyst workflows, IOC enrichment, ATT&CK mapping, threat hunting, feeds, exports, and reporting.",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkxOverKill/Pulse_Intel.git"
  },
  "bugs": {
    "url": "https://github.com/SkxOverKill/Pulse_Intel/issues"
  },
  "homepage": "https://github.com/SkxOverKill/Pulse_Intel#readme",
  "keywords": [
    "threat-intelligence",
    "cti",
    "ioc",
    "mitre-attack",
    "threat-hunting",
    "security",
    "soc",
    "osint"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:dev": "prisma dev --name pulse",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:offline": "tsx scripts/migrate-offline.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:verify-backup": "tsx scripts/verify-backup-restore.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "attack:sync": "tsx --max-old-space-size=3072 scripts/attack-sync.ts",
    "cve:catchup": "tsx scripts/nvd-catchup.ts",
    "vuln:prune": "tsx scripts/vuln-prune.ts",
    "news:relink": "tsx scripts/relink-news.ts",
    "db:studio": "prisma studio",
    "verify:enrichment": "tsx scripts/verify-enrichment.ts",
    "verify:hunting": "tsx scripts/verify-hunting.ts",
    "verify:api": "tsx scripts/verify-api.ts",
    "verify:reports": "tsx scripts/verify-reports.ts",
    "worker": "tsx src/worker.ts",
    "feeds:install": "tsx scripts/install-feeds.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.4",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.33.0",
    "next": "^16.3.3",
    "prisma": "^7.10.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
